# =============================================================================
# .env.example — copy to `.env` (or export in your shell) and fill in values.
# Secrets are never committed; the config loader expands ${VAR} references
# and api_key_env entries from your environment.
# =============================================================================

# --- Remote cloud supervisor (at least one provider) ---
# DeepSeek (recommended: cheap + strong)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Local worker (usually no key needed; placeholder is fine) ---
# LM Studio  : http://127.0.0.1:1234/v1
# Ollama     : http://127.0.0.1:11434/v1
# vLLM       : http://127.0.0.1:8000/v1
# llama.cpp  : http://127.0.0.1:8080/v1
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPAT_API_KEY=lm-studio

# --- Plugin / bridge ---
# MINIONS_CONFIG=/absolute/path/to/minions.yaml
# MINIONS_BRIDGE_PY=python
# MINIONS_BRIDGE_SCRIPT=python/minions_bridge.py
# MINIONS_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
